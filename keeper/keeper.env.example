# Copy to /etc/blackout/keeper.env (chmod 0600, chown blackout). This file never enters the repository.
RPC_URL=https://rpc.robinhood-chain.example           # Robinhood Chain (4663) JSON-RPC endpoint you pay for
REGISTRY=0x_published_GameRegistry_address              # the registry from application job A (wiring registers the roles)
KEEPER_KEY=0x_64_hex_private_key_of_a_dedicated_hot_wallet   # fund with a little ETH; bounties refill it
# v3.9 attestation relay: schedules bought on Ethereum with consumer {chainId 4663, verifyingContract DESK}
# ORACLE_API=https://api.imd.fun
# SCHEDULE_EVENT=uuid_of_the_event_schedule
# SCHEDULE_REGULATOR=uuid_of_the_regulator_schedule
# RELAY_INTERVAL=60                                     # seconds between HTTP polls of the schedules
# v3.9 platform fee claim for the paying wallet (permissionless; sends only when fees accrued)
# LAUNCH_FACTORY=0xa25b02a1e93903b790e6aaf7da1b8b8d50294645
# TOKEN_LAUNCH=launch_number_of_the_token_launch
# CLAIM_INTERVAL=21600
# WIRING_FILE=/etc/blackout/wiring.json                 # default for `node keeper.mjs wire`
# Optional
# CHAIN_ID=4663
# STATE_FILE=/var/lib/blackout/keeper-state.json
# PRIORITY_FEE_WEI=1000000
